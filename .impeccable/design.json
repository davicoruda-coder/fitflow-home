  "narrative": {
    "northStar": "The Calm Home Circuit",
    "overview": "FitFlow Home looks like a focused training studio that lives in your pocket: quiet surfaces, one strong green voice for action, and a warm ember accent for rest/energy moments — never a flashy gym marketing page. Density stays comfortable for phone thumbs while desktop opens into a side-rail + two-column operate layout without inventing a second brand. The system is intentionally lean: solid elevated panels, hairline borders, soft ambient glows, and short purposeful motion.",
    "keyCharacteristics": [
      "Operate-mode product UI (tasks over spectacle)",
      "Dual-theme green primary + ember secondary",
      "Sora display + Manrope body",
      "Large rounded controls and 48–56px tap targets",
      "Mobile bottom nav / desktop side rail"
    ],
    "rules": [
      {
        "name": "The One Canopy Rule",
        "body": "Primary green drives CTAs and active state; don’t introduce a third brand hue. Ember is reserved for rest/energy/caution.",
        "section": "colors"
      },
      {
        "name": "The Soft Companion Rule",
        "body": "Accent text sits on its soft tint, never raw neon on paper.",
        "section": "colors"
      },
      {
        "name": "The Cue Clarity Rule",
        "body": "Exercise guidance is body-size muted text under the title — never decorative display competing with the exercise name.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Cards stay flat (border + elevated fill). Don’t add multi-layer soft UI shadows or glass blur on desktop.",
        "section": "elevation"
      },
      {
        "name": "The Confirm Drastic Rule",
        "body": "Logout, reset, and mid-session abandon always require an explicit second step.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep primary CTAs canopy green and large enough for thumbs (min-h-14 when primary).",
      "Do use ember for rest/energy/caution — not as a second primary CTA color.",
      "Do preserve light/dark token pairs when adding surfaces.",
      "Do prefer solid elevated panels on desktop (performance + clarity).",
      "Do keep exercise names readable (allow 2 lines) beside thumbs."
    ],
    "donts": [
      "Don’t introduce purple/indigo AI-default palettes or cream+terracotta editorial clichés foreign to this canopy/ember system.",
      "Don’t add glassmorphism / heavy backdrop-blur back onto cards or the side rail.",
      "Don’t inflate the UI with dashboard chrome, stat strips, or marketing hero overlays inside the operate app shell.",
      "Don’t skip confirmation on destructive actions.",
      "Don’t invent a third accent hue for variety."
